# PostgreSQL connection used by packages/db.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prelude?schema=public"

# Public app URLs used by local E2E tests and cross-app links.
NEXT_PUBLIC_CONSOLE_URL="http://localhost:3000"
NEXT_PUBLIC_CANDIDATE_URL="http://localhost:3001"

# Anonymous marketing demo. Run `pnpm marketing-demo:seed` after migrations.
# The same high-entropy bearer secret is configured on the marketing website
# and candidate app; it authenticates website-to-candidate admission/exchange
# and must never use a NEXT_PUBLIC_ name.
MARKETING_DEMO_SERVICE_SECRET=""
# Exact, comma-separated result URLs. No origin wildcards or path prefixes.
MARKETING_DEMO_RETURN_TARGETS="http://localhost:3000/demo/result"
# Cloudflare Turnstile server secret used only by the marketing website route.
# Without it production fails closed. Local automated tests may set an explicit
# proof below; there is deliberately no built-in development bypass value.
MARKETING_DEMO_TURNSTILE_SECRET=""
NEXT_PUBLIC_MARKETING_DEMO_TURNSTILE_SITE_KEY=""
MARKETING_DEMO_TEST_BOT_PROOF=""
# Base64-encoded 32-byte AES-256-GCM key for the short-lived handoff relay.
MARKETING_DEMO_HANDOFF_ENCRYPTION_KEY=""

# Clerk V1 console authentication.
# Create a Clerk application, enable Organizations, then copy keys from the Clerk dashboard.
CONSOLE_AUTH_PROVIDER="auto"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/onboarding/organization"
# Optional, tests only: read by @clerk/testing (clerkSetup / setupClerkTestingToken
# in apps/console/e2e), never by application code. Leave it empty and Clerk mints
# the token from CLERK_SECRET_KEY; set it to pin a pre-generated one.
CLERK_TESTING_TOKEN=""
# Svix signing secret for the Clerk webhook (Dashboard > Webhooks > your endpoint).
# Required in production to sync Clerk org memberships/invitations into the DB
# via POST /api/clerk/webhook. Subscribe: organizationMembership.*,
# organizationInvitation.*, subscription.* / subscriptionItem.* (billing), and
# user.updated. Do NOT subscribe to user.created or user.deleted — see
# docs/operations/production-go-live-runbook.md for the full subscription
# list and why those two are deliberately excluded.
CLERK_WEBHOOK_SIGNING_SECRET=""
# Enable only after organization Billing and the V1 Workspace plan exist in the
# matching Clerk instance. Disabled local environments stay explicitly
# unmetered; production fails closed.
CLERK_BILLING_ENABLED="false"
CLERK_BILLING_V1_PLAN_SLUG="v1-workspace"
CLERK_BILLING_PROJECTION_MAX_AGE_SECONDS="3024000"
# Prepaid credit billing (issue #140 phase 1). Off = legacy Clerk projection.
CREDIT_BILLING_ENABLED=0

# Stripe (prepaid credit purchases, #140 phase 2). Test-mode keys; real values
# live dotenvx-encrypted in .env.
STRIPE_SECRET_KEY=""
# NOT a shared secret: `stripe listen` mints a different one per developer, so a
# value committed here or written into the shared dotenvx .env would make every
# other machine answer 400. Put the `whsec_…` that
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# prints into `apps/console/.env.local` (gitignored, and the file Next actually
# reads for the console). Deployed environments take it from the dashboard
# webhook endpoint config instead.
STRIPE_WEBHOOK_SECRET=""
# Bearer secret for POST /api/internal/billing-sweep (generate: openssl rand -hex 32).
# Schedule the endpoint at least hourly wherever CREDIT_BILLING_ENABLED=1.
# Locally it belongs in `apps/console/.env.local` next to the webhook secret; the
# `make billing-sweep` client reads it from the shell, so export it there too.
BILLING_SWEEP_SECRET=""
# Bearer secret for POST /api/internal/retention-sweep (generate: openssl rand -hex 32).
# The 12-month transcript + brief retention sweep; schedule it DAILY in every
# environment holding real candidate data. Its own secret, separate from the
# billing one, because this endpoint permanently deletes candidate data.
RETENTION_SWEEP_SECRET=""
# Optional, `make billing-packs-sync` only: rotate catalogue prices without
# editing the script, e.g. PACK_PRICE_OVERRIDES='{"hiring_100":{"eur":39900,"usd":39900}}'.
# Both currencies are required per pack — the sync refuses a partial override.
PACK_PRICE_OVERRIDES=""

# First-party connected accounts.
# Generate a 32-byte key with: openssl rand -base64 32
CONNECTED_ACCOUNT_ENCRYPTION_KEY=""
# Optional; defaults to CLERK_SECRET_KEY or the encryption key in production.
CONNECTED_ACCOUNT_STATE_SECRET=""

# Google OAuth web application credentials. Authorized redirect URI:
# http://localhost:3000/api/integrations/google/callback
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI=""

# Transactional notification emails. Disabled by default so local development
# and automated tests never send an external email. Enable explicitly only
# after configuring a verified Resend sender domain.
NOTIFICATIONS_ENABLED="0"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="HireCall <notifications@example.com>"

# Local-only Clerk mock used by the console when CONSOLE_AUTH_PROVIDER is "mock"
# or when CONSOLE_AUTH_PROVIDER is "auto" and Clerk keys are empty.
# The mock is disabled in production. Use Clerk test helpers for real auth E2E.
MOCK_CLERK_USER_ID="user_demo"
MOCK_CLERK_USER_EMAIL="recruiter@hirecall.ai"
MOCK_CLERK_USER_NAME="Adrien Kouyate"
MOCK_CLERK_ORG_ID="org_demo"
MOCK_CLERK_ORG_ROLE="owner"

# Base URL of the Go realtime API, read by the PYTHON side of the stack: the
# interviewer agent (services/interviewer-agent) and the benchmark harness. Both
# `python -m app.auto_worker` and `python -m app.live_worker` accept it either as
# --realtime-api-url or, when that flag is absent, from this variable — so a
# container needs nothing but the environment. `make live-openai-*worker` passes
# the flag, and an explicit flag always wins. It is a DISTINCT name from
# PRELUDE_REALTIME_API_URL below: same service, different reader.
REALTIME_API_URL="http://localhost:8080"
# Shared bearer secret every caller of the Go realtime API must send. The Go
# service enforces it whenever it is set and REFUSES TO BOOT without it when
# APP_ENV=production. The Python workers read it as the fallback for --api-key.
REALTIME_API_KEY=""
# Port the GO REALTIME SERVICE listens on; 8080 when unset, and most hosting
# platforms inject their own value. The Next apps ignore it — they pin
# --port 3000 / 3001 in their own dev scripts — so leaving it empty is correct
# everywhere but a self-hosted realtime deployment.
PORT=""
# Live voice provider the Go service reports to the interviewer agent. Unset
# means "mock" — set it to openai_realtime in any environment interviewing real
# candidates. Valid values: openai_realtime, elevenlabs, mock.
LIVE_INTERVIEW_PROVIDER="openai_realtime"

# The candidate/console apps (TypeScript) reach that SAME Go realtime API via
# PRELUDE_REALTIME_API_URL — a DISTINCT name from REALTIME_API_URL above, kept
# separate because the Python worker and the Next.js apps read different
# variables. In production it MUST be set to the deployed realtime service URL,
# or live interviews fall back to localhost.
PRELUDE_REALTIME_API_URL="http://localhost:8080"

# Production hardening — see docs/operations/production-go-live-runbook.md.
# APP_ENV=production makes the realtime service fail fast on missing
# DB/Redis/LiveKit config and hard-disables every mock interview path. The
# console refuses CONSOLE_AUTH_PROVIDER=mock when EITHER switch says production.
APP_ENV=""
# Node runtime mode for the JS apps. `next build` / `next start` set production
# for you, so this is mostly the local default — but wherever you do set it by
# hand, it must say production in production.
NODE_ENV="development"
# Default-deny: a mock (scripted, no-audio) interview runs only when this is
# explicitly true AND APP_ENV is not production. Local smoke runs only.
ALLOW_MOCK_INTERVIEW=""

# Redis ephemeral orchestration for automatic live interviewer dispatch.
REDIS_URL="redis://localhost:6380/0"
AGENT_JOIN_STREAM_KEY="prelude:agent-join:stream"
# Consumer group the Python auto-worker joins. Every worker replica must use the
# same value or a job is delivered to each group instead of once overall.
AGENT_JOIN_CONSUMER_GROUP="prelude-live-workers"
AGENT_JOIN_PENDING_IDLE_SECONDS="30"
LIVE_WORKER_MAX_CONCURRENCY="2"

# LiveKit media plane. Use LiveKit Cloud or a local LiveKit server.
LIVEKIT_URL="wss://..."
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Recruiter replay. Capture is opt-in and starts only after the candidate accepts
# the current audio-recording consent copy. LiveKit writes mixed OGG/Opus audio
# directly to this private R2 bucket; the console serves short-lived signed URLs.
# Candidates are told their recording is stored in the European Union, so in
# production the realtime service refuses to boot with recording on unless the
# destination attests EU placement: point EGRESS_R2_ENDPOINT at Cloudflare's
# eu-jurisdiction endpoint (https://<account_id>.eu.r2.cloudflarestorage.com —
# the binding guarantee, and it keeps the S3 region at the "auto" R2 requires),
# or set EGRESS_R2_REGION to eu/weur/eeur.
#
# RECORDING_ENABLED is read by THREE processes and they must agree: the Go
# realtime service (services/realtime), which starts or refuses the egress; the
# candidate app (apps/candidate), which reads it to choose which consent variant
# the pre-join screens render and stamp — candidate-consent-v3 when recording is
# on, candidate-consent-v3-no-recording when it is off; and the console
# (apps/console), which reads it to quote that same variant back to the recruiter
# in the pre-publish trust panel. Set all three from the same deployment config.
# They cannot disagree about what "on" MEANS: both TypeScript readers share one
# parse rule in @prelude/core (policies/recording.ts), pinned by test against the
# Go switch's accepted spellings ("1", "true", "yes"), so a change on one side
# fails the build rather than drifting silently. A mismatch in the flag's VALUE
# still cannot open a hole (the realtime gate accepts only the audio-disclosing
# consent ids, so an app with the flag off stamps a no-recording version and the
# service then declines to record) but it does produce a deployment that promises
# a replay it never captures — and a trust panel showing recruiters copy their
# candidates never see.
RECORDING_ENABLED="0"
RECORDING_RETENTION_DAYS="90"
EGRESS_R2_BUCKET=""
EGRESS_R2_ENDPOINT=""
EGRESS_R2_REGION="auto"
EGRESS_R2_ACCESS_KEY_ID=""
EGRESS_R2_SECRET_ACCESS_KEY=""

# OpenAI Realtime benchmark provider.
OPENAI_API_KEY=""
INTERVIEW_DRAFT_GENERATOR="openai"
INTERVIEW_DRAFT_LLM_MODEL="gpt-4.1-mini"
INTERVIEW_DRAFT_LLM_TIMEOUT_SECONDS="12"
PROTECTED_TOPIC_CLASSIFIER="openai"
PROTECTED_TOPIC_LLM_MODEL="gpt-4.1-mini"
PROTECTED_TOPIC_LLM_TIMEOUT_SECONDS="6"
OPENAI_REALTIME_MODEL="gpt-realtime-2.1"
OPENAI_REALTIME_VOICE="marin"
# Deterministic business lines use TTS; voice falls back to the Realtime voice.
OPENAI_EXACT_TTS_MODEL="gpt-4o-mini-tts"
OPENAI_EXACT_TTS_VOICE=""
# Read only by the deprecated LIVEKIT_LEGACY_TURN_HANDLING rollback.
OPENAI_REALTIME_TURN_DETECTION="semantic_vad"
OPENAI_REALTIME_REASONING_EFFORT="low"
# Read only by the deprecated LIVEKIT_LEGACY_TURN_HANDLING rollback.
OPENAI_REALTIME_TRANSCRIPTION_MODEL="gpt-4o-transcribe"
OPENAI_ANSWER_INFERENCE_ENABLED="1"
OPENAI_ANSWER_INFERENCE_MODEL="gpt-5.4-nano"
OPENAI_ANSWER_INFERENCE_TIMEOUT_SECONDS="3.5"
LIVE_WORKER_MAX_DURATION_SECONDS=""
LIVE_WORKER_CANDIDATE_READY_TIMEOUT_SECONDS="120"
LIVE_WORKER_INACTIVITY_USER_AWAY_SECONDS="15"
LIVE_WORKER_INACTIVITY_WARNING_SECONDS="20"
LIVE_WORKER_INACTIVITY_TERMINATE_SECONDS="20"
LIVE_WORKER_CANDIDATE_WAIT_SECONDS="60"
LIVE_WORKER_CANDIDATE_ABSENCE_GRACE_SECONDS="360"
LIVEKIT_TURN_DETECTOR_VERSION="v1-mini"
# Dynamic endpointing learns within this range; the ceiling protects natural pauses.
LIVEKIT_ENDPOINTING_MIN_DELAY_SECONDS="1"
LIVEKIT_ENDPOINTING_MAX_DELAY_SECONDS="5"
# The last complete answer gets an extra cancellable window before checkout.
LIVE_WORKER_FINAL_ANSWER_GRACE_SECONDS="3"
# Aligned transcript delivered to HireCall's business-policy turn hook.
LIVEKIT_STT_MODEL="deepgram/nova-3"
# Emergency rollback only. LiveKit Turn Detector owns production turn handling.
LIVEKIT_LEGACY_TURN_HANDLING="false"

# ElevenLabs benchmark provider.
ELEVENLABS_API_KEY=""
ELEVENLABS_AGENT_ID=""
ELEVENLABS_VOICE_ID=""
ELEVENLABS_CONVERSATION_MODE="speech_engine"
ELEVENLABS_TURN_EAGERNESS="normal"

# Benchmark controls.
BENCHMARK_PROVIDER="mock_openai_realtime"
BENCHMARK_RUN_ID=""
BENCHMARK_SCENARIO="normal"
BENCHMARK_ITERATIONS="3"
# Keep paid/provider-backed LLM benchmark runs disabled by default.
ALLOW_LIVE_LLM_TESTS="0"
# Candidate evidence synthesis. Keep provider-backed analysis explicit and
# allow enough time for structured output before the conservative fallback.
CANDIDATE_BRIEF_LLM_ENABLED=0
CANDIDATE_BRIEF_LLM_MODEL=gpt-4.1-mini
CANDIDATE_BRIEF_LLM_TIMEOUT_SECONDS=20
# Private role brief import. Set ROLE_INTAKE_ENABLED=1 only after all R2 and
# ClamAV variables below are configured. Keep this bucket private; no public
# read route is used by HireCall.
ROLE_INTAKE_ENABLED=0
# Indexed fallback for LinkedIn, Indeed, and public pages that cannot be
# extracted statically. Requires OPENAI_API_KEY. Paid live tests stay opt-in.
ROLE_INTAKE_INDEXED_SEARCH_ENABLED=0
ROLE_INTAKE_INDEXED_SEARCH_MODEL=gpt-5.6-luna
ROLE_INTAKE_INDEXED_SEARCH_TIMEOUT_SECONDS=20
ALLOW_LIVE_JOB_URL_TESTS=0
ROLE_INTAKE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
ROLE_INTAKE_R2_ACCESS_KEY_ID=
ROLE_INTAKE_R2_SECRET_ACCESS_KEY=
ROLE_INTAKE_R2_BUCKET=prelude-role-intakes
ROLE_INTAKE_R2_REGION=auto
ROLE_INTAKE_CLAMAV_HOST=127.0.0.1
ROLE_INTAKE_CLAMAV_PORT=3310
