generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                     String                        @id @default(cuid())
  clerkOrganizationId    String?                       @unique
  name                   String
  companySize            String?
  hiringFocus            String?
  defaultInterviewMode   String?
  // Declared jurisdiction hint (organizationCountrySchema enum in @prelude/contracts),
  // settings-only, owner/admin submit only. Never a fiscal fact and never a
  // currency input — fiscal authority stays the address Stripe collects at
  // Checkout. Null means "nobody told us"; no inference, no backfill.
  country                String?
  settings               Json                          @default("{}")
  onboardingState        Json                          @default("{}")
  onboardingStep         String                        @default("welcome")
  onboardingCompletedAt  DateTime?
  createdAt              DateTime                      @default(now())
  candidateBriefs        CandidateBrief[]
  candidateInvitations   CandidateInvitation[]
  notificationDeliveries NotificationDelivery[]
  candidateReviewEvents  CandidateSessionReviewEvent[]
  candidateSessions      CandidateSession[]
  candidatePreviews      CandidateExperiencePreview[]
  scheduledCalls         CandidateScheduledCall[]
  connectedAccounts      ConnectedAccount[]
  interviewDrafts        InterviewDraft[]
  interviews             Interview[]
  jobs                   Job[]
  jobSourceConnections   JobSourceConnection[]
  roleIntakes            RoleIntake[]
  memberships            OrganizationMembership[]
  invitations            OrganizationInvitation[]
  billingState           OrganizationBillingState?
  creditWallet           CreditWallet?
  creditLots             CreditLot[]
  creditLedgerEntries    CreditLedgerEntry[]
  creditReservations     CreditReservation[]
}

model User {
  id                                  String                        @id @default(cuid())
  clerkUserId                         String                        @unique
  email                               String                        @unique
  name                                String?
  preferredLanguage                   String                        @default("en")
  createdAt                           DateTime                      @default(now())
  candidateReviewEvents               CandidateSessionReviewEvent[] @relation("CandidateReviewEventAuthor")
  scheduledCalls                      CandidateScheduledCall[]      @relation("CandidateScheduledCallCreatedBy")
  candidateSessionReviewNoteUpdates   CandidateSession[]            @relation("CandidateSessionReviewNoteAuthor")
  candidateSessionReviewStatusUpdates CandidateSession[]            @relation("CandidateSessionReviewStatusAuthor")
  connectedAccounts                   ConnectedAccount[]
  createdRoleIntakes                  RoleIntake[]                  @relation("RoleIntakeCreator")
  createdCandidatePreviews            CandidateExperiencePreview[]  @relation("CandidatePreviewCreator")
  memberships                         OrganizationMembership[]
}

model OrganizationMembership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String
  onboardingRole String?
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
}

model OrganizationInvitation {
  id              String       @id @default(cuid())
  organizationId  String
  email           String
  role            String
  status          String       @default("pending")
  invitedByUserId String?
  createdAt       DateTime     @default(now())
  acceptedAt      DateTime?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId, status])
}

model Job {
  id                   String                @id @default(cuid())
  organizationId       String
  title                String
  location             String?
  description          String                @default("")
  sourceProvider       String?
  sourceExternalId     String?
  sourceAttachmentName String?
  status               String                @default("draft")
  createdAt            DateTime              @default(now())
  organization         Organization          @relation(fields: [organizationId], references: [id])
  interviewDrafts      InterviewDraft[]
  interviews           Interview[]
  candidates           Candidate[]
  candidateInvitations CandidateInvitation[]
  candidateSessions    CandidateSession[]
  roleIntake           RoleIntake?

  @@index([organizationId, sourceProvider])
}

// A private staging object for imported role sources. It deliberately becomes a
// visible Job only after the recruiter has reviewed the extracted fields.
model RoleIntake {
  id                       String            @id @default(cuid())
  organizationId           String
  createdByUserId          String
  sourceKind               String            @default("file")
  submittedUrl             String?
  canonicalUrl             String?
  sourceIdentity           String?
  sourceMetadata           Json              @default("{}")
  status                   String            @default("uploading")
  originalFileName         String
  declaredMimeType         String
  detectedMimeType         String?
  byteSize                 Int?
  sha256                   String?
  quarantineObjectKey      String?
  sealedObjectKey          String?
  extractedDraft           Json              @default("{}")
  reviewedDraft            Json              @default("{}")
  warnings                 Json              @default("[]")
  reviewVersion            Int               @default(0)
  reviewedAt               DateTime?
  reviewedByUserId         String?
  scannerVersion           String?
  parserVersion            String?
  attemptCount             Int               @default(0)
  nextAttemptAt            DateTime?
  processingStartedAt      DateTime?
  processingLeaseExpiresAt DateTime?
  lastErrorCode            String?
  lastErrorSummary         String?
  duplicateOfIntakeId      String?
  expiresAt                DateTime
  cleanupRequestedAt       DateTime?
  cleanedUpAt              DateTime?
  jobId                    String?           @unique
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  organization             Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy                User              @relation("RoleIntakeCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  job                      Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  events                   RoleIntakeEvent[]

  @@unique([organizationId, sha256])
  @@unique([organizationId, sourceIdentity])
  @@index([organizationId, status, updatedAt])
  @@index([duplicateOfIntakeId])
  @@index([status, nextAttemptAt])
  @@index([createdByUserId, createdAt])
}

// Audit and pilot telemetry for an intake. The metadata is intentionally
// structural only; it must never include document text, filenames, hashes or
// candidate data.
model RoleIntakeEvent {
  id           String     @id @default(cuid())
  roleIntakeId String
  eventType    String
  metadata     Json       @default("{}")
  createdAt    DateTime   @default(now())
  roleIntake   RoleIntake @relation(fields: [roleIntakeId], references: [id], onDelete: Cascade)

  @@index([roleIntakeId, createdAt])
  @@index([eventType, createdAt])
}

model InterviewDraft {
  id                   String                       @id @default(cuid())
  organizationId       String
  jobId                String
  status               String                       @default("draft")
  roleTitle            String
  roleBrief            String                       @default("")
  seniority            String?
  focus                Json                         @default("[]")
  responseModes        Json                         @default("[]")
  questions            Json                         @default("[]")
  criteria             Json                         @default("[]")
  guardrails           Json                         @default("[]")
  estimatedMinutes     Int?
  rationale            String?
  // Language the generated content was written in. Null means "generated before stamping existed" — never a default, never a backfill.
  language             String?
  sourceAttachmentName String?
  schemaVersion        Int                          @default(1)
  generatorProvider    String?
  generatorModel       String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  organization         Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job                  Job                          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  interview            Interview?
  candidatePreviews    CandidateExperiencePreview[]

  @@index([organizationId, status, updatedAt])
  @@index([jobId, status])
}

model CandidateExperiencePreview {
  id               String         @id
  organizationId   String
  draftId          String
  createdByUserId  String
  tokenDigest      String         @unique
  snapshot         Json
  schemaVersion    Int            @default(1)
  expiresAt        DateTime
  runtimeExpiresAt DateTime?
  liveTestCount    Int            @default(0)
  revokedAt        DateTime?
  createdAt        DateTime       @default(now())
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  draft            InterviewDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  createdBy        User           @relation("CandidatePreviewCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([expiresAt])
  @@index([runtimeExpiresAt])
}

model Interview {
  id                   String                @id @default(cuid())
  organizationId       String
  jobId                String
  draftId              String?               @unique
  publicToken          String                @unique
  status               String                @default("published")
  roleTitle            String
  roleBrief            String                @default("")
  seniority            String?
  focus                Json                  @default("[]")
  responseModes        Json                  @default("[]")
  questions            Json                  @default("[]")
  criteria             Json                  @default("[]")
  guardrails           Json                  @default("[]")
  estimatedMinutes     Int?
  rationale            String?
  // Language the generated content was written in, copied from the draft at publish. Null means "generated before stamping existed" — never a default, never a backfill.
  language             String?
  schemaVersion        Int                   @default(1)
  generatorProvider    String?
  generatorModel       String?
  // N6b: immutable audit record of a recruiter override of an LLM protected-topic
  // flag at publish (null on a clean publish). Append-only; never edited.
  complianceOverride   Json?
  publishedAt          DateTime              @default(now())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job                  Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  draft                InterviewDraft?       @relation(fields: [draftId], references: [id], onDelete: SetNull)
  candidateInvitations CandidateInvitation[]
  candidateSessions    CandidateSession[]

  @@index([organizationId, status, updatedAt])
  @@index([jobId, status])
}

// N6b anti-gaming: an append-only, queryable log of every applied LLM
// protected-topic override. Powers the per-recruiter rolling-window rate limit
// and is the foundation for an org-level override-frequency report. Standalone
// (no FK relations) so it stays a pure audit index; rows are never edited.
model ComplianceOverrideEvent {
  id                 String   @id @default(cuid())
  organizationId     String
  interviewId        String?
  overriddenByUserId String
  overriddenByRole   String
  justification      String
  category           String
  classifierProvider String
  classifierModel    String
  createdAt          DateTime @default(now())

  @@index([organizationId, overriddenByUserId, createdAt])
  @@index([organizationId, createdAt])
}

model CandidateInvitation {
  id                 String             @id @default(cuid())
  organizationId     String
  jobId              String
  interviewId        String
  token              String             @unique
  candidateName      String?
  candidateEmail     String?
  status             String             @default("invited")
  expiresAt          DateTime
  openedAt           DateTime?
  consentedAt        DateTime?
  consentCopyVersion String?
  // Language of the consent copy actually shown at consent time, written by the server that rendered it. Null = consented before language was recorded — never backfill.
  consentLanguage    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job                Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  interview          Interview          @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  candidateSessions  CandidateSession[]

  @@index([organizationId, status, expiresAt])
  @@index([interviewId, status])
  @@index([jobId, status])
}

model CandidateSession {
  id                      String                        @id @default(cuid())
  organizationId          String
  jobId                   String
  interviewId             String
  candidateInvitationId   String?
  realtimeSessionId       String?                       @unique
  candidateName           String?
  candidateEmail          String?
  resumeToken             String?                       @unique
  consentedAt             DateTime?
  consentCopyVersion      String?
  // Language of the consent copy actually shown at consent time, written by the server that rendered it. Null = consented before language was recorded — never backfill.
  consentLanguage         String?
  recordingEntitled       Boolean                       @default(false)
  status                  String                        @default("created")
  reviewStatus            String                        @default("to_review")
  reviewNote              String?
  reviewStatusUpdatedAt   DateTime?
  reviewStatusUpdatedById String?
  reviewNoteUpdatedAt     DateTime?
  reviewNoteUpdatedById   String?
  startedAt               DateTime?
  completedAt             DateTime?
  // Phase 2 (#140, amendment 18): the billing trace for this session's
  // settlement. Written once by `settleCandidateSessionCredit` — only when
  // `CREDIT_BILLING_ENABLED` is on and the terminal kind is `completed` — and
  // never touched for any other kind (abandoned/failed/expired/superseded).
  // `billedOutcome` ("captured" | "released") is the honest signal for
  // billed-vs-not: a `CreditReservation` row can change status for reasons
  // unrelated to this settlement (e.g. a later TTL sweep), so it is not a
  // reliable historical record. These three columns are the written trace
  // that backs a billing dispute; they hold whatever justified the decision,
  // charged or not.
  billedAnsweredCount     Int?
  billedRequiredCount     Int?
  billedOutcome           String?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  organization            Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job                     Job                           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  interview               Interview                     @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  candidateInvitation     CandidateInvitation?          @relation(fields: [candidateInvitationId], references: [id], onDelete: SetNull)
  candidateBrief          CandidateBrief?
  notificationDeliveries  NotificationDelivery[]
  scheduledCalls          CandidateScheduledCall[]
  reviewEvents            CandidateSessionReviewEvent[]
  reviewStatusUpdatedBy   User?                         @relation("CandidateSessionReviewStatusAuthor", fields: [reviewStatusUpdatedById], references: [id], onDelete: SetNull)
  reviewNoteUpdatedBy     User?                         @relation("CandidateSessionReviewNoteAuthor", fields: [reviewNoteUpdatedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, updatedAt])
  @@index([organizationId, startedAt])
  @@index([organizationId, reviewStatus, updatedAt])
  @@index([jobId, status])
  @@index([interviewId, status])
  @@index([candidateInvitationId, status])
  @@index([reviewStatusUpdatedById])
  @@index([reviewNoteUpdatedById])
}

// Clerk owns billing state. This row is a privacy-minimal projection used for
// low-latency product authorization in public candidate and realtime flows.
// Payment methods, invoices, prices and raw provider payloads never live here.
model OrganizationBillingState {
  organizationId         String       @id
  clerkSubscriptionId    String?
  clerkPlanId            String?
  planSlug               String?
  planName               String?
  state                  String
  subscriptionStatus     String?
  subscriptionItemId     String?
  subscriptionItemStatus String?
  isFreeTrial            Boolean      @default(false)
  periodStart            DateTime?
  periodEnd              DateTime?
  sourceUpdatedAt        DateTime
  syncedAt               DateTime     @default(now())
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([state, periodEnd])
}

// Credit billing (issue #140, phase 1). The ledger is append-only and is the
// source of truth; the wallet row caches totals and is the FOR UPDATE lock
// target that serialises credit operations per organization. Rows here must
// survive product-row deletion, so nothing cascades from CandidateSession and
// organizations with billing history cannot be hard-deleted (Restrict).
model CreditWallet {
  id                 String       @id @default(cuid())
  organizationId     String       @unique
  availableCredits   Int          @default(0)
  reservedCredits    Int          @default(0)
  stripeCustomerId   String?      @unique
  // Locked at the first paid lot from session.currency (grantPurchasedCreditLot);
  // a later purchase in a different currency is refused, never converted — the
  // prorata auto-refund math is only computable when every paid lot shares one
  // currency. Free lots never set nor check it.
  settlementCurrency String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

model CreditLot {
  id                      String              @id @default(cuid())
  organizationId          String
  kind                    String // free | paid
  source                  String // first_five | pack_purchase | auto_topup | manual_grant | enterprise_commitment
  packId                  String?
  creditsGranted          Int
  creditsConsumed         Int                 @default(0)
  creditsReserved         Int                 @default(0)
  unitAmountCents         Int?
  currency                String              @default("EUR")
  // Observed at fulfilment from session.customer_details.address.country (the
  // tax-grade fact Stripe collected at Checkout). Never copied to
  // Organization.country — observed and declared stay separate columns with
  // separate authority. Absent address stays null; no error.
  billingCountry          String?
  status                  String              @default("active") // active | exhausted | expired | frozen | revoked
  grantedAt               DateTime
  expiresAt               DateTime
  // Phase 2 (#140) amendment 11: when a chargeback froze this lot. Kept after the
  // dispute is won — the clock kept running while the credits were unspendable,
  // and this is the only record of how long, which is what a future
  // expiry-extension decision needs. Overwritten only by a LATER freeze.
  frozenAt                DateTime?
  stripePaymentIntentId   String?             @unique
  stripeCheckoutSessionId String?             @unique
  stripeInvoiceId         String?             @unique
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  organization            Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ledgerEntries           CreditLedgerEntry[]
  reservations            CreditReservation[]

  @@index([organizationId, status, expiresAt])
}

model CreditLedgerEntry {
  id                 String       @id @default(cuid())
  organizationId     String
  lotId              String?
  type               String // free_grant | pack_purchase | reserve | release | consume | refund_reversal | expire | manual_adjustment | dispute_freeze | dispute_release
  delta              Int // signed change to available credits (see plan header)
  candidateSessionId String?
  stripeEventId      String?
  actorKind          String       @default("system") // system | stripe_webhook | admin
  actorId            String?
  reason             String?
  createdAt          DateTime     @default(now())
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lot                CreditLot?   @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
}

model CreditReservation {
  id                 String       @id @default(cuid())
  organizationId     String
  candidateSessionId String       @unique
  lotId              String
  status             String       @default("held") // held | captured | released
  heldAt             DateTime
  expiresAt          DateTime
  resolvedAt         DateTime?
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lot                CreditLot    @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, expiresAt])
}

// Phase 2 (#140): the purchasable catalogue. Stripe Products/Prices are the
// price authority; this row maps a stable pack slug to the active Stripe
// price and caches display values. Prices rotate by pointing stripePriceId
// at a new Price — past purchases are never rewritten (their unitAmountCents
// lives on the CreditLot). The local cache follows Stripe, never leads it:
// unitAmountCents/unitAmountCentsUsd are only written once Stripe confirms
// the Price (sync script amendment 2).
model CreditPack {
  id                 String   @id // stable slug: starter_25 | hiring_100 | scale_500 | volume_1000
  creditsGranted     Int
  unitAmountCents    Int // display cache (EUR); Stripe Price is authoritative at checkout
  unitAmountCentsUsd Int? // display cache (USD) — currency_options mirror on the Stripe Price
  currency           String   @default("EUR")
  stripeProductId    String?  @unique
  stripePriceId      String?  @unique
  visibility         String   @default("public") // public (pricing surfaces) | quiet (purchasable, never listed)
  enabled            Boolean  @default(true)
  displayOrder       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// Local archive of every received Stripe event: Stripe retains events 30
// days; reconciliation and dispute forensics need longer. Dedupe hygiene
// only — the anti-double-credit guarantee is CreditLot's unique Stripe ids.
// attemptCount/firstError/lastError track replay: Stripe replays events, and
// the upsert never silently overwrites a prior needs_admin/failed status with
// processed — transitions are explicit (amendment 8).
//
// The two error columns are deliberately NOT redundant, and the distinction is
// what makes the history survive a retry:
//   firstError — the error of the FIRST failed attempt. Written once, never
//                overwritten, never cleared. This is the forensic record: the
//                original cause is what explains a failure, and a retry that
//                fails differently (or succeeds) must not be able to erase it.
//   lastError  — the error of the MOST RECENT failed attempt. Overwritten on
//                each new failure and cleared when a replay finally settles
//                `processed`. This is the operational view: what is wrong now.
// So a row that recovered keeps firstError (what went wrong) with lastError
// null (nothing wrong now), and every clear is logged.
model StripeWebhookEvent {
  id            String    @id @default(cuid())
  stripeEventId String    @unique
  type          String
  payload       Json
  status        String    @default("received") // received | processed | ignored | failed | needs_admin
  firstError    String?
  attemptCount  Int       @default(1)
  lastError     String?
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?

  @@index([type, receivedAt])
}

model CandidateSessionReviewEvent {
  id                 String           @id @default(cuid())
  organizationId     String
  candidateSessionId String
  authorUserId       String
  eventType          String
  previousStatus     String?
  nextStatus         String?
  note               String?
  createdAt          DateTime         @default(now())
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidateSession   CandidateSession @relation(fields: [candidateSessionId], references: [id], onDelete: Cascade)
  author             User             @relation("CandidateReviewEventAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([candidateSessionId, createdAt])
  @@index([organizationId, createdAt])
  @@index([authorUserId, createdAt])
}

model CandidateBrief {
  id                 String           @id @default(cuid())
  organizationId     String
  candidateSessionId String           @unique
  status             String           @default("pending")
  summaryJson        Json             @default("{}")
  recommendation     String?
  limitations        Json             @default("[]")
  evidence           Json             @default("[]")
  // Language the generated brief was written in. Null means "generated before stamping existed" — never a default, never a backfill.
  language           String?
  modelProvider      String?
  modelName          String?
  schemaVersion      Int              @default(1)
  generatedAt        DateTime?
  failedReason       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidateSession   CandidateSession @relation(fields: [candidateSessionId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, updatedAt])
}

model NotificationDelivery {
  id                 String                @id @default(cuid())
  organizationId     String
  candidateSessionId String?
  eventType          String
  recipientEmail     String
  dedupeKey          String                @unique
  status             String                @default("pending")
  provider           String?
  providerMessageId  String?
  payloadVersion     Int                   @default(1)
  attemptCount       Int                   @default(0)
  attemptedAt        DateTime?
  sentAt             DateTime?
  skippedAt          DateTime?
  failedAt           DateTime?
  errorCode          String?
  errorSummary       String?
  // Locale the delivery was rendered in — recorded for audit alongside the
  // recipient's User.preferredLanguage that drove it. Written by the
  // notification service (T4); templates stay EN copy for now.
  locale             String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidateSession   CandidateSession?     @relation(fields: [candidateSessionId], references: [id], onDelete: Cascade)
  attempts           NotificationAttempt[]

  @@index([organizationId, status, updatedAt])
  @@index([candidateSessionId, eventType])
  @@index([recipientEmail, createdAt])
}

model NotificationAttempt {
  id                String               @id @default(cuid())
  notificationId    String
  attemptNumber     Int
  provider          String?
  providerMessageId String?
  status            String
  errorCode         String?
  errorSummary      String?
  createdAt         DateTime             @default(now())
  notification      NotificationDelivery @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, attemptNumber])
  @@index([status, createdAt])
}

model JobSourceConnection {
  id             String       @id @default(cuid())
  organizationId String
  provider       String
  status         String
  externalLabel  String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, provider])
  @@index([provider])
}

model ConnectedAccount {
  id                     String                   @id @default(cuid())
  organizationId         String
  userId                 String
  provider               String
  status                 String                   @default("connected")
  capabilities           Json                     @default("[]")
  scopes                 Json                     @default("[]")
  externalAccountId      String?
  externalAccountEmail   String?
  accessTokenCiphertext  String?
  refreshTokenCiphertext String?
  accessTokenExpiresAt   DateTime?
  lastRefreshAttemptAt   DateTime?
  lastRefreshError       String?
  connectedAt            DateTime?
  disconnectedAt         DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  organization           Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scheduledCalls         CandidateScheduledCall[]
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, provider])
  @@index([organizationId, provider, status])
  @@index([userId, provider])
}

model CandidateScheduledCall {
  id                    String            @id @default(cuid())
  organizationId        String
  candidateSessionId    String
  createdByUserId       String
  connectedAccountId    String?
  activeScheduleKey     String?           @unique
  provider              String            @default("google_calendar")
  providerCalendarId    String            @default("primary")
  providerEventId       String
  providerEventUrl      String?
  status                String            @default("creating")
  startsAt              DateTime
  endsAt                DateTime
  timeZone              String
  summary               String
  attendeeEmails        Json              @default("[]")
  inviteCandidate       Boolean           @default(false)
  conferenceRequested   Boolean           @default(false)
  conferenceStatus      String?
  location              String?
  conferenceJoinUrl     String?
  lastProviderErrorCode String?
  lastProviderErrorAt   DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidateSession      CandidateSession  @relation(fields: [candidateSessionId], references: [id], onDelete: Cascade)
  createdBy             User              @relation("CandidateScheduledCallCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  connectedAccount      ConnectedAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: SetNull)

  @@unique([connectedAccountId, providerCalendarId, providerEventId])
  @@index([organizationId, status, startsAt])
  @@index([candidateSessionId, createdAt])
}

model Candidate {
  id        String   @id @default(cuid())
  jobId     String
  fullName  String
  email     String
  status    String   @default("to_review")
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id])
}

model LiveInterviewSession {
  id                String                   @id
  interviewPlanId   String                   @map("interview_plan_id")
  candidateId       String                   @map("candidate_id")
  status            String
  livekitRoomName   String                   @map("livekit_room_name")
  allowedModalities Json                     @map("allowed_modalities")
  kind              String                   @default("candidate")
  expiresAt         DateTime?                @map("expires_at") @db.Timestamptz
  createdAt         DateTime                 @map("created_at")
  updatedAt         DateTime                 @map("updated_at")
  events            LiveInterviewEvent[]
  recordings        LiveInterviewRecording[]

  @@index([kind, expiresAt])
  @@map("live_interview_sessions")
}

model LiveInterviewEvent {
  id               String               @id @map("event_id")
  sessionId        String               @map("session_id")
  candidateId      String               @map("candidate_id")
  actor            String
  type             String
  occurredAt       DateTime             @map("occurred_at")
  idempotencyKey   String               @map("idempotency_key")
  sequenceNumber   Int                  @map("sequence_number")
  payload          Json
  providerMetadata Json                 @default("{}") @map("provider_metadata")
  session          LiveInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, idempotencyKey])
  @@unique([sessionId, sequenceNumber])
  @@index([sessionId, occurredAt, id])
  @@index([sessionId, type, sequenceNumber], map: "live_interview_events_session_id_type_sequence_number_idx")
  @@map("live_interview_events")
}

model LiveInterviewRecording {
  id            String               @id
  sessionId     String               @map("session_id")
  egressId      String?              @unique @map("egress_id")
  objectKey     String?              @map("object_key")
  status        String
  format        String
  layout        String?
  durationMs    Int?                 @map("duration_ms")
  failedReason  String?              @map("failed_reason")
  startedAt     DateTime             @map("started_at")
  endedAt       DateTime?            @map("ended_at")
  createdAt     DateTime             @map("created_at")
  updatedAt     DateTime             @map("updated_at")
  deletedAt     DateTime?            @map("deleted_at")
  deletedReason String?              @map("deleted_reason")
  session       LiveInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@index([status, endedAt])
  @@map("live_interview_recordings")
}
